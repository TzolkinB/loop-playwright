{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "../app/lib/**/*.mjs",
    "../app/src/data/**/*.ts",
    "../data/*.json"
  ]
}
